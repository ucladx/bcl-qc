manifest {
    name = 'bcl-qc-nf'
    description = 'DRAGEN demultiplexing, alignment and QC'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version = '2.0.0-rc2'
}

params {
    run_dir = null
    fastqs_dir = '/staging/hot/reads'
    bams_dir = '/mnt/pns/bams'
    sampleinfo = null
    steps = 'demux,align,qc'
    dry_run = false                                      // command planning only; used by dragen_validate --dry-run
    qcsum_config = "${projectDir}/config/qcsum_config.yaml"
    multiqc_config = "${projectDir}/config/multiqc_config.yaml"
    picard_ref = '/mnt/pns/tracks/ref/hg38.fa'
    pcp_bed = '/mnt/pns/tracks/ucla_mdl_cancer_ngs_v1_exon_targets.hg38.bed'
    heme_bed = '/mnt/pns/tracks/goal_ucla_heme_221_exon_targets.hg38.bed'
    pcp_human_ref = '/staging/human/reference/hg38_alt_masked_graph_v3'
    heme_human_ref = '/staging/human/reference/hg38_alt_masked_graph_v3'
    dragen_tmp = '/staging/tmp'                          // DRAGEN --intermediate-results-dir
    dragen_lock = '/staging/tmp/.bclqc_dragen.lock'      // host-wide flock around every DRAGEN call (across launches)
    dragen_lock_wait = 43200                             // seconds a DEMUX/ALIGN task waits for that lock (12 h), then fails
    forbid_prefixes = ''                                 // comma list; run dirs / written paths equal to, inside or linking into -> error
}

process {
    executor = 'local'
    // Outputs are written in place; existing files determine which work is skipped.
    cache = false
    withName: 'DEMUX|ALIGN' {
        maxForks = 1
    }
}
